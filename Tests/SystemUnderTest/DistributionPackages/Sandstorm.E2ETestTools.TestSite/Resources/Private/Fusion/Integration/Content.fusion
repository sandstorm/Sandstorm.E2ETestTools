prototype(Sandstorm.E2ETestTools.TestSite:Content.Section) < prototype(Neos.Neos:ContentComponent) {
    renderer = afx`<section><Neos.Neos:ContentCollectionRenderer /></section>`
}

prototype(Sandstorm.E2ETestTools.TestSite:Content.Headline) < prototype(Neos.Neos:ContentComponent) {
    renderer = Neos.Neos:Editable {
        property = 'title'
    }
}

prototype(Sandstorm.E2ETestTools.TestSite:Content.Button) < prototype(Neos.Neos:ContentComponent) {
    renderer = Sandstorm.E2ETestTools.TestSite:Component.Button {
        title = Neos.Neos:Editable {
            property = 'title'
            block = false
        }
        type = ${node.properties.type}
        href = Neos.Neos:ConvertUris {
            value = ${node.properties.link}
            @if.hasLink = ${node.properties.link}
        }
    }
}

prototype(Sandstorm.E2ETestTools.TestSite:Content.Download) < prototype(Neos.Neos:ContentComponent) {
    renderer = afx`
        <a href={props.fileUri} download>
            <Neos.Neos:Editable property="description" block={false} />
        </a>
    `
    fileUri = Neos.Fusion:ResourceUri {
        resource = ${node.properties.file.resource}
        @if.hasFile = ${node.properties.file}
    }
}

prototype(Sandstorm.E2ETestTools.TestSite:Content.Image) < prototype(Neos.Neos:ContentComponent) {
    imageUri = Neos.Neos:ImageUri {
        asset = ${node.properties.image}
        maximumWidth = 400
        @if.hasImage = ${node.properties.image}
    }
    renderer = afx`
        <figure>
            <img src={props.imageUri} alt={node.properties.alternativeText} data-testid="image" />
            <figcaption>{node.properties.image.copyrightNotice}</figcaption>
        </figure>
    `
}

// the width attribute sets the shown width - no CSS needed
prototype(Sandstorm.E2ETestTools.TestSite:Content.ResponsiveImage) < prototype(Neos.Neos:ContentComponent) {
    srcset = Neos.Fusion:Map {
        items = ${[200, 400, 600, 800, 1000]}
        itemRenderer = Neos.Fusion:Join {
            uri = Neos.Neos:ImageUri {
                asset = ${node.properties.image}
                maximumWidth = ${item}
            }
            descriptor = ${' ' + item + 'w'}
        }
        @process.join = ${Array.join(value, ', ')}
    }
    renderer = afx`
        <img srcset={props.srcset} sizes={node.properties.sizes} width={node.properties.width} alt={node.properties.alternativeText} />
    `
}

prototype(Sandstorm.E2ETestTools.TestSite:Content.TestMarkup) < prototype(Neos.Neos:ContentComponent) {
    renderer = Neos.Fusion:Renderer {
        type = ${'Sandstorm.E2ETestTools.TestSite:TestMarkup.' + node.properties.markup}
    }
}
