<?php

declare(strict_types=1);

use Behat\Behat\Context\Context;
use Behat\Behat\Hook\Scope\BeforeScenarioScope;
use Behat\Testwork\Hook\Scope\BeforeSuiteScope;
use Neos\Behat\FlowBootstrapTrait;
use Neos\Behat\FlowEntitiesTrait;
use Neos\Flow\ObjectManagement\ObjectManagerInterface;
use Sandstorm\E2ETestTools\Tests\Behavior\Bootstrap\FusionRenderingTrait;
use Sandstorm\E2ETestTools\Tests\Behavior\Bootstrap\NeosBackendControlTrait;
use Sandstorm\E2ETestTools\Tests\Behavior\Bootstrap\NodeImportTrait;
use Sandstorm\E2ETestTools\Tests\Behavior\Bootstrap\PlaywrightTrait;
use function PHPUnit\Framework\assertEquals;

require_once(__DIR__ . '/../../../../../../Packages/Application/Sandstorm.E2ETestTools/Tests/Behavior/Bootstrap/PlaywrightTrait.php');
require_once(__DIR__ . '/../../../../../../Packages/Application/Sandstorm.E2ETestTools/Tests/Behavior/Bootstrap/NeosBackendControlTrait.php');
require_once(__DIR__ . '/../../../../../../Packages/Application/Sandstorm.E2ETestTools/Tests/Behavior/Bootstrap/FusionRenderingTrait.php');
require_once(__DIR__ . '/../../../../../../Packages/Application/Sandstorm.E2ETestTools/Tests/Behavior/Bootstrap/NodeImportTrait.php');

/**
 * This class is copied to new projects when setting up behat E2E tests via Sandstorm.E2ETestTools
 */
class FeatureContext implements Context
{
    // Bootstraps Flow and provides getObject() (part of Neos.Behat)
    use FlowBootstrapTrait;

    // Truncates Flow entity tables before each @flowEntities scenario (part of Neos.Behat)
    use FlowEntitiesTrait;

    // Browser Automation
    use PlaywrightTrait;

    // Render Fusion code and Styleguide; create nodes via Neos 9 CR API (part of Sandstorm.E2ETestTools)
    use FusionRenderingTrait;

    // Backend login/navigation, page visits and assertions (part of Sandstorm.E2ETestTools)
    use NeosBackendControlTrait;

    // Create nodes from YAML fixture files (part of Sandstorm.E2ETestTools)
    use NodeImportTrait;

    // !!! Set this to the Flow context the SYSTEM UNDER TEST actually runs under -
    // NOT this runner's own context. Used by executeFlowCommand() below to shell
    // commands into the SUT rather than into this Behat process. E.g. 'Production/E2E-SUT'.
    protected string $flowContextForSystemUnderTest = 'Testing/Behat';


    public function __construct()
    {
        self::bootstrapFlow();
        $this->setupPlaywright();

        // !!! You need to add the Site Package Key here, so that we are able to load the Fusion code properly.
        $this->setupFusionRendering('Site.Package.Key.Here');

        // Resources created by fixture steps are published automatically. For the system under test to find them,
        // Testing/Behat must use the same persistent resource storage and target as the SUT context (see README).
    }

    /**
     * @BeforeSuite
     */
    public static function prepareSUT(BeforeSuiteScope $scope): void
    {
        exec("./flow flow:doctrine:compileproxies");
    }

    public function getObjectManager(): ObjectManagerInterface
    {
        return self::$bootstrap->getObjectManager();
    }

    /**
     * @BeforeScenario @flowEntities
     */
    public function beforeFixturesScenario(BeforeScenarioScope $scope): void
    {
        $this->setupContentRepository();
    }

    protected function executeFlowCommand(string $command, string $errorDescription): bool
    {
        $output = [];
        $resultCode = -100;
        exec("FLOW_CONTEXT=$this->flowContextForSystemUnderTest ./flow $command", $output, $resultCode);
        if ($resultCode !== 0) {
            echo "ERROR: could not $errorDescription";
            echo print_r($output, true);
            return false;
        }
        print_r($output);
        return true;
    }

    /**
     * @When /^I pause for debugging$/
     */
    public function iPauseForDebugging(): void
    {
        $this->playwrightConnector->execute(
            $this->requirePlaywrightContext(),
            <<<JS
                await vars.page.pause();
            JS
        );
    }

    /**
     * @Then I should see the page title :title
     */
    public function iShouldSeeThePageTitle($title): void
    {
        $actualTitle = $this->playwrightConnector->execute(
            $this->requirePlaywrightContext(),
            <<<JS
            return await vars.page.title();
            JS
        );
        assertEquals($title, $actualTitle, "page titles do not match");
    }
}
