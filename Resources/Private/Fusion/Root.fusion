e2eTestRoot = Sandstorm.E2ETestTools:RenderedElement

prototype(Sandstorm.E2ETestTools:RenderedElement) < prototype(Neos.Fusion:Case) {
    default {
        @position = 'end 9999'
        condition = true
        // defined in FusionRenderingTrait::internalRender
        renderPath = ${renderPath}
        @process.addToResult = ${fusionRenderingResult.setAndReturnRenderedElement(value)}
    }
}
